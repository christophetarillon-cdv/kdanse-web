rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && (
        userData.get('role', '') == 'admin' ||
        'admin' in userData.get('roles', [])
      );
    }

    function isLinkedToMembership(membershipId) {
      let membership = get(/databases/$(database)/documents/memberships/$(membershipId)).data;
      return request.auth != null && (
        membership.userId == request.auth.uid ||
        request.auth.uid in membership.get('visibleUserIds', [])
      );
    }

    // Tokens Dropbox partagés : tout utilisateur authentifié
    match /config/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Collections sans donnée sensible propre à un individu : accès
    // authentifié, comme avant.
    // Un commandeur est "manager" d'un danseur qui a son propre compte :
    // il peut mettre à jour le profil du danseur, sans toucher aux autres champs.
    // Le lien est posé par ajout de son uid dans managedBy (un seul uid à la fois).
    match /users/{userId} {
      // Lecture ouverte aux comptes connectés : l'app mobile liste les membres.
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        (
          request.auth.uid in resource.data.get('managedBy', []) &&
          request.resource.data.get('managedBy', []) == resource.data.get('managedBy', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'updatedAt']) &&
          request.resource.data.profile.diff(resource.data.get('profile', {})).affectedKeys()
            .hasOnly(['firstName', 'lastName', 'dateOfBirth', 'postalAddress', 'license'])
        ) ||
        (
          request.auth.uid in request.resource.data.get('managedBy', []) &&
          !(request.auth.uid in resource.data.get('managedBy', [])) &&
          request.resource.data.get('managedBy', []).hasAll(resource.data.get('managedBy', [])) &&
          request.resource.data.get('managedBy', []).size() == resource.data.get('managedBy', []).size() + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managedBy'])
        )
      );
    }

    // Index email -> uid, pour retrouver le compte d'un danseur à partir de son email
    match /emailIndex/{emailKey} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    match /activites/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /analytics_events/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /analytics_sessions/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /annonces/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /channelReads/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /inscriptions/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /medias/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /participations/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /seances/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /soiree/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Collections kdanse-web (Phase 4 - Gestion des Accès)
    // Permissive for development - restrict in production
    match /seasons/{document=**} {
      allow read, write: if true;
    }
    match /stages/{document=**} {
      allow read, write: if true;
    }
    match /memberships/{document=**} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid in resource.data.get('visibleUserIds', []) ||
        isAdmin()
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow create: if true;
    }
    match /reservations/{document=**} {
      allow read, write: if true;
    }
    match /carts/{document=**} {
      allow read, write: if true;
    }

    match /paymentPlans/{document=**} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.get('visibleUserIds', []) ||
        isAdmin()
      );
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow create: if request.auth != null;
    }

    match /paymentInstallments/{document=**} {
      allow read: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/paymentPlans/$(resource.data.paymentPlanId)).data.userId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/paymentPlans/$(resource.data.paymentPlanId)).data.get('visibleUserIds', [])
      );
      allow write: if isAdmin();
      allow create: if request.auth != null;
    }

    match /paymentSettings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Courses (dances, levels, courses)
    match /dances/{document=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
      );
    }
    match /levels/{document=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
      );
    }
    match /courses/{document=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
      );
    }
    match /membershipCourses/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isAdmin() ||
        isLinkedToMembership(request.resource.data.membershipId)
      );
      allow update, delete: if request.auth != null && (
        isAdmin() ||
        isLinkedToMembership(resource.data.membershipId)
      );
    }

    // Messages privés : réservés aux 2 participants du canal et aux admins.
    // Les autres types de canal (annonces/général/activité) restent ouverts
    // à tout utilisateur authentifié, comme avant.
    match /channels/{channelId} {
      allow read: if request.auth != null &&
        (resource.data.type != 'prive' ||
         request.auth.uid in resource.data.membres ||
         isAdmin());
      allow write: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          (get(/databases/$(database)/documents/channels/$(channelId)).data.type != 'prive' ||
           request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.membres ||
           isAdmin());
        allow write: if request.auth != null;
      }
    }
  }
}
