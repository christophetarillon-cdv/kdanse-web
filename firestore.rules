rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: authentifiés peuvent lire/écrire leur profil, admins gèrent tout
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // AppSettings: admins seulement
    match /appSettings/{document=**} {
      allow read, write: if isAdmin();
    }

    // Stages: tous les utilisateurs connectés peuvent lire, admins écrivent
    match /stages/{stageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    // Memberships: utilisateurs voient leurs adhésions, tous créent et payent les leurs
    match /memberships/{membershipId} {
      allow read: if request.auth.uid != null;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // PaymentGroups: utilisateurs voient les leurs, admins gèrent
    match /paymentGroups/{paymentGroupId} {
      allow read: if request.auth.uid != null;
      allow write: if isAdmin();
    }

    // PaymentInstallments: admins seulement
    match /paymentInstallments/{installmentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // BankAccounts: admins seulement
    match /bankAccounts/{accountId} {
      allow read, write: if isAdmin();
    }

    // Existing collections: garder l'ouverture pour l'app mobile
    match /seances/{seanceId} {
      allow read, write: if isAuthenticated();
    }

    match /activites/{activiteId} {
      allow read, write: if isAuthenticated();
    }

    match /inscriptions/{inscriptionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /users/{userId}/photos/{photoId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    match /medias/{mediaId} {
      allow read, write: if isAuthenticated();
    }

    match /annonces/{annonce} {
      allow read, write: if isAuthenticated();
    }

    match /channels/{channelId} {
      allow read, write: if isAuthenticated();
    }

    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /config/{configId} {
      allow read, write: if isAuthenticated();
    }

    match /participations/{participationId} {
      allow read, write: if isAuthenticated();
    }

    match /soiree/{soireeId} {
      allow read, write: if isAuthenticated();
    }
  }

  function isAuthenticated() {
    return request.auth != null;
  }

  function isAdmin() {
    return isAuthenticated() &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
  }
}
