rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && (
        'admin' in userData.roles ||
        userData.role == 'admin'
      );
    }

    // Tokens Dropbox partagés : tout utilisateur authentifié
    match /config/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Collections sans donnée sensible propre à un individu : accès
    // authentifié, comme avant.
    match /users/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /activites/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /analytics_events/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /analytics_sessions/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /annonces/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /channelReads/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /inscriptions/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /medias/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /participations/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /seances/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /soiree/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Collections kdanse-web (Phase 4 - Gestion des Accès)
    // Permissive for development - restrict in production
    match /seasons/{document=**} {
      allow read, write: if true;
    }
    match /stages/{document=**} {
      allow read, write: if true;
    }
    match /memberships/{document=**} {
      allow read, write: if true;
    }
    match /reservations/{document=**} {
      allow read, write: if true;
    }

    // Messages privés : réservés aux 2 participants du canal et aux admins.
    // Les autres types de canal (annonces/général/activité) restent ouverts
    // à tout utilisateur authentifié, comme avant.
    match /channels/{channelId} {
      allow read: if request.auth != null &&
        (resource.data.type != 'prive' ||
         request.auth.uid in resource.data.membres ||
         isAdmin());
      allow write: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          (get(/databases/$(database)/documents/channels/$(channelId)).data.type != 'prive' ||
           request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.membres ||
           isAdmin());
        allow write: if request.auth != null;
      }
    }
  }
}
